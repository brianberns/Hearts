<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Players.fs" />
    <Compile Include="Bench.fs" />
    <Compile Include="Phase0.fs" />
    <Compile Include="Gpu.fs" />
    <Compile Include="Tune.fs" />
    <Compile Include="Benchmark.fs" />
    <Compile Include="WData.fs" />
    <Compile Include="WFit.fs" />
    <Compile Include="WExact.fs" />
    <Compile Include="Duplicate.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the same native libraries as Hearts.Train, which shares the output folder; models still run on the CPU -->
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.105.2" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="TorchSharp-cuda-linux" Version="0.105.2" Condition="'$(OS)' != 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearts.Heuristic\Hearts.Heuristic.fsproj" />
    <ProjectReference Include="..\Hearts.Model\Hearts.Model.fsproj" />
  </ItemGroup>

</Project>
